# Copiar como .env y definir dos contraseñas locales distintas antes de arrancar.
MYSQL_DATABASE=alimentacion_hospitalaria
MYSQL_USER=alimentacion_app
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
MYSQL_PORT=3307
APP_PORT=8080

# Activar temporalmente "inicializacion" para crear el primer administrador.
SPRING_PROFILES_ACTIVE=
APP_ADMIN_USERNAME=
APP_ADMIN_PASSWORD=
APP_ADMIN_FULL_NAME=
